<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema mientras arranca el proceso (modo claro): pantalla de carga de ATENA. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Fondo de la ventana detrás de Flutter mientras inicializa y durante la ejecución. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/atena_splash_background</item>
    </style>
</resources>
